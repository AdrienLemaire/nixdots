# Report CWD to tmux (and terminal) via OSC 7 so #{pane_current_path} tracks navigation
function _report_cwd() { printf '\033]7;file://%s%s\000' "$HOST" "$PWD"; }
precmd_functions+=(_report_cwd)

export CARAPACE_BRIDGES='zsh,fish,bash,inshellisense' # optional
zstyle ':completion:*' format $'\e[2;37mCompleting %d\e[m'
source <(carapace _carapace)

eval "$(zoxide init zsh)"
alias vi=nvim
alias vim=nvim
# Claude account wrappers, named the same on the laptop and the Hetzner box:
# claudeA = adrien@, claudeF = founders@. They tag the tmux pane with its account,
# so the window list shows which accounts a window runs (@claude_acct_list in
# tmux.nix). Exiting clears the tag and also the status circle, in case Claude
# died without running its SessionEnd hook.
_claude_as() {
  local acct=$1; shift
  [ -n "$TMUX" ] && tmux set -p -t "$TMUX_PANE" @claude_pane_acct "$acct"
  command claude "$@"
  local ret=$?
  [ -n "$TMUX" ] && tmux set -pu -t "$TMUX_PANE" @claude_pane_acct \; set -pu -t "$TMUX_PANE" @claude_pane_status
  return $ret
}
claudeA() { CLAUDE_CONFIG_DIR=~/.claude-adrien _claude_as A "$@"; }
claudeF() { CLAUDE_CONFIG_DIR=~/.claude-founders _claude_as F "$@"; }
# Bare `claude` is this machine's default account (founders@ on the Hetzner box).
claude() { claudeA "$@"; }

# Attach to (or create) the persistent agent tmux session. The server runs as
# the tmux-main user service in agents.slice (modules/system/memory.nix), out
# of reach of ghostty/compositor scope deaths — reattach with `cz` after any
# crash or re-login. If the service is unavailable, -A falls back to creating
# the session in-place (old behavior).
cz() {
  systemctl --user start tmux-main 2>/dev/null
  tmux new-session -A -s main
}

export PATH="$HOME/.local/bin:$PATH"

# Topic-scoped Claude sessions. Each one cds first, because Claude Code scopes a
# session to its working directory: history, project memory and CLAUDE.md all come
# from there. That keeps goal-tracking context out of code sessions and vice versa.
# These call the claude() wrapper above, so the tmux account marker still works.
# Pass -c to continue that directory's most recent session: `goals -c`.
_goals_dir=~/Projects/Perso/personal-goals

goals() { cd "$_goals_dir" && claude "$@"; }
dev()   { cd ~/Projects/Perso/cartoucherie && claude "$@"; }
# Job hunt: the cv repo is added so its CV source and rules are readable.
jh()    { cd ~/Projects/Perso/job-hunt && claude --add-dir ../cv "$@"; }
# jhw <name> -- a repo change in its own worktree; the script is in the repo.
jhw()   { ~/Projects/Perso/job-hunt/scripts/jhw.sh "$@"; }

# goal <name> -- a session narrowed to ONE goal, e.g. `goal sport`.
# Same repo, same memory, same skills; only the system prompt is scoped, so a
# check-in about the dog doesn't drag in six other goals.
goal() {
  if [ $# -eq 0 ]; then
    echo "usage: goal <name>" >&2
    (cd "$_goals_dir" && ls *.md | grep -v -E '^(README|CLAUDE|streaks)\.md$' | sed 's/\.md$//' | sed 's/^/  /') >&2
    return 1
  fi
  local g=$1; shift
  [ -f "$_goals_dir/$g.md" ] || { echo "no such goal: $g" >&2; return 1; }
  cd "$_goals_dir" && claude --append-system-prompt \
    "This session is scoped to one goal: $g.md. Read README.md, $g.md and the newest weekly/ file, then respond. Do not review or report on the other goals unless explicitly asked." "$@"
}
